    <!-- Mercators -->
    <!-- 
    note that since Mercators need goods from the Latium region (Soap and Olive Oil), and since this mod makes it so you need to meet
    ALL needs, not just half of them, the result is if you start in Albion, and start with Roman celts, you are stuck and won't be able
    to promote a Mercator to Tier3 Noble, which is needed to unlock the Latium region.  You need to start with Celts instead.  Or, disable
    this mod long enough to promote some Nobles, then you can turn it back on after you've unlocked Latium
    -->
    <ModOp Merge="@6475/Residence7/UpgradeThreshold">
        <UpgradeThreshold>
            <Public>
                <Value>6</Value>
            </Public>
            <Food>
                <Value>6</Value>
            </Food>
            <Fashion>
                <Value>6</Value>
            </Fashion>
            <Household>
                <Value>4</Value>
            </Household>
        </UpgradeThreshold>
    </ModOp>

