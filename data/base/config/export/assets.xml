    <!-- Mercators -->
    <!-- note that we do not double the Mercator Household requirement, since:
            IF the user starts in Albion, and
            IF the user starts with Roman celts, then
            there is no way to promote a Mercator to Noble, since doing so requires a) Fashion / Soap, and b) Household / Olive Oil
        We'll leave the Fashion requirement doubled, and require the user to fill that need by purchasing some Soap from
        Corvinus Procurator.  But there is no way to acquire Olive Oil
    -->
    <ModOp Merge="@6475/Residence7/UpgradeThreshold">
        <UpgradeThreshold>
            <Public>
                <Value>6</Value>
            </Public>
            <Food>
                <Value>6</Value>
            </Food>
            <Fashion>
                <Value>6</Value>
            </Fashion>
            <Household>
                <Value>2</Value>
            </Household>
        </UpgradeThreshold>
    </ModOp>

    <!-- Nobles -->
