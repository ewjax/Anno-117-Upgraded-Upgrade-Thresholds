            <Public>
                <Value>6</Value>
            </Public>
            <Food>
                <Value>6</Value>
            </Food>
            <Fashion>
                <Value>6</Value>
            </Fashion>
            <Household>
                <Value>4</Value>
            </Household>
        </UpgradeThreshold>
    </ModOp>

